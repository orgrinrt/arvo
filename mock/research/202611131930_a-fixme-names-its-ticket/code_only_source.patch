+/// Every line of every comment in the file, with its 1-based line number.
+///
+/// Doc comments and block comments included, each line of a block comment on
+/// its own. A marker written in a string literal is not here, which is the
+/// point: a lint asking what a comment says is asking the one parse, not a
+/// scan for `//`.
+pub fn comment_lines<'a>(ctx: &'a LintContext<'a>) -> Vec<(usize, &'a str)> {
+    let source = ctx.source();
+    let mut out = Vec::new();
+    let mut cursor = ctx.tree().walk();
+    'walk: loop {
+        let node = cursor.node();
+        if COMMENTS.contains(&node.kind()) {
+            let text = &source[node.start_byte() .. node.end_byte()];
+            for (i, line) in text.lines().enumerate() {
+                out.push((node.start_position().row + i + 1, line));
+            }
+        } else if cursor.goto_first_child() {
+            continue;
+        }
+        loop {
+            if cursor.goto_next_sibling() {
+                continue 'walk;
+            }
+            if !cursor.goto_parent() {
+                break 'walk;
+            }
+        }
+    }
+    out
+}
