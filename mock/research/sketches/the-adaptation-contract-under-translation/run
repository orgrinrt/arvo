#!/usr/bin/env bash
# The adaptation contract under translation and under reflection.
#
#   mock/research/sketches/the-adaptation-contract-under-translation/run
#
# Everything lands under `out/` and is committed. Exit status is not the result;
# the captured text is. Every step declares in its own source what must fail, and
# the verdict lines say HELD or BROKEN per arm. Nothing here is BROKEN in the
# committed run; step 05's `P1` was, in the first revision, and the file it
# refuted says what it caught.
#
# Release profile throughout, because these are exhaustive sweeps and a debug
# build takes long enough that somebody would sample instead. No timing is taken
# here and no number in the design is a duration, so the profile is a runtime
# convenience rather than a measurement condition. Nothing here is a benchmark
# and nothing here is called one.

set -u
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
out="$here/out"
mkdir -p "$out"

echo "building"
( cd "$here" && cargo build --release 2>&1 ) > "$out/00_build.txt"
echo "exit=$?" >> "$out/00_build.txt"

for step in \
    s01_rounding_equivariance \
    s02_completion_homomorphy \
    s03_relocation \
    s04_reflection \
    s05_the_predicate
do
    echo "$step"
    "$here/target/release/$step" > "$out/${step}.txt" 2>&1
    echo "exit=$?" >> "$out/${step}.txt"
done

echo "the verdict lines, gathered"
grep -hE "^([WCRNP][0-9][a-z]?): " "$out"/s0*.txt > "$out/06_verdicts.txt"
cat "$out/06_verdicts.txt"
